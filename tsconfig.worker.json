{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "vitest/globals"],
    "noEmit": true,
    "composite": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["worker/**/*.ts"],
  "exclude": ["node_modules"]
}
