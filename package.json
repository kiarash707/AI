{
  "name": "kayro-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "worker:dev": "wrangler dev --env dev --var DEV_MODE:true --ip 0.0.0.0 --port 8789",
    "build": "npm run check && vite build",
    "check": "tsc -b --pretty false && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "format:check": "prettier --check src worker design-system .github README.md package.json tsconfig.json tsconfig.worker.json vite.config.ts .prettierrc.json",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "^0.468.0",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prettier": "^3.9.10",
    "vitest": "latest",
    "wrangler": "^4.151.3"
  }
}
